{
  "permissions": {
    "allow": [
      "Bash(python3 tools/coord.py *)",
      "Bash(python3 tools/coord.py)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/coord.py\" hook session-start",
            "timeout": 45,
            "statusMessage": "Checking the team inbox"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/coord.py\" hook prompt",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/coord.py\" hook guard-push",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
